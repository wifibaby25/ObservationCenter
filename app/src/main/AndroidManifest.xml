<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <application
        android:name=".App"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.ObsCenter"
        android:usesCleartextTraffic="true">
        <activity
            android:name=".ui.LoginActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".ui.MainActivity" android:exported="false" />
        <activity android:name=".ui.ChatActivity" android:exported="false" />
        <activity android:name=".ui.VisitorActivity" android:exported="false" />
        <activity android:name=".ui.MemberActivity" android:exported="false" />
        <activity android:name=".ui.VisitorsActivity" android:exported="false" />
        <activity android:name=".ui.TicketsActivity" android:exported="false" />
        <activity android:name=".ui.OrderDetailActivity" android:exported="false" />
        <activity android:name=".ui.StockActivity" android:exported="false" />
        <activity android:name=".ui.CommodityActivity" android:exported="false" />
        <activity android:name=".ui.BlocklistActivity" android:exported="false" />
        <activity android:name=".ui.SearchActivity" android:exported="false" />
        <activity android:name=".ui.DeviceActivity" android:exported="false" />
        <activity android:name=".ui.QuickManageActivity" android:exported="false" />
        <activity android:name=".ui.RulesManageActivity" android:exported="false" />
        <activity android:name=".ui.StatsActivity" android:exported="false" />
        <activity android:name=".ui.StoreActivity" android:exported="false" />
        <activity android:name=".ui.CashDetailActivity" android:exported="false" />
        <activity android:name=".ui.HealthActivity" android:exported="false" />
        <service
            android:name=".ui.SseService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="IM 实时消息长连监听" />
        </service>
    </application>

</manifest>
